{
  "info": {
    "name": "Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"user@example.com\",\"full_name\":\"User Example\",\"password\":\"password123\",\"role\":\"user\"}"
        },
        "url": "{{baseUrl}}/v1/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"user@example.com\",\"password\":\"password123\"}"
        },
        "url": "{{baseUrl}}/v1/auth/login"
      }
    },
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Finish assignment\",\"description\":\"Complete API requirements\",\"priority\":2}"
        },
        "url": "{{baseUrl}}/v1/tasks"
      }
    },
    {
      "name": "List Tasks",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/v1/tasks?limit=20&offset=0&sort_by=priority&sort_dir=asc"
      }
    },
    {
      "name": "Task Stats Cache",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/v1/tasks/stats"
      }
    },
    {
      "name": "External UUID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/external/uuid"
      }
    }
  ]
}
